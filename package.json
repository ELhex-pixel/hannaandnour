{
  "name": "hanna-nour",
  "version": "1.0.0",
  "private": true,
  "description": "Hanna & Nour - modest fashion e-commerce (static site + Netlify Functions + Stripe + Supabase)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "deploy": "netlify deploy --prod"
  },
  "dependencies": {
    "@netlify/functions": "^2.8.2",
    "@supabase/supabase-js": "^2.45.4",
    "stripe": "^16.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "cheerio": "^1.1.2",
    "sharp": "^0.35.5",
    "netlify-cli": "^27.10.2"
  },
  "overrides": {
    "sharp": "$sharp",
    "multiparty": "^4.3.1",
    "on-headers": "^1.1.0"
  }
}
