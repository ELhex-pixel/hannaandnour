# ---------------------------------------------------------------
# Hanna & Nour - environment configuration (Netlify Functions)
#
# Copy this file to ".env" for local development with `netlify dev`,
# AND set the same variables as Environment variables in the Netlify
# dashboard (Site settings > Environment variables).
#
# NEVER commit the real .env file or these secret values.
# ---------------------------------------------------------------

# --- Supabase (https://supabase.com) ---
# Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# This is the SECRET service role key. Server-side only. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Stripe (https://dashboard.stripe.com) ---
STRIPE_SECRET_KEY=sk_test_...
# Set after creating the webhook endpoint (see SETUP.md)
STRIPE_WEBHOOK_SECRET=whsec_...
# Currency used for payments (lowercase ISO code)
STRIPE_PRICE_CURRENCY=usd

# --- Site ---
# Public URL of your site (no trailing slash). Used for Stripe redirect URLs.
SITE_URL=http://localhost:8888

# --- Business rules ---
# Tax rate as a decimal (0.07 = 7%). Set 0 to charge no separate tax.
TAX_RATE=0.07
# Free shipping threshold (in cents)
FREE_SHIPPING_THRESHOLD_CENTS=7500
# Shipping costs (in cents)
SHIPPING_STANDARD_CENTS=699
SHIPPING_EXPRESS_CENTS=1200
SHIPPING_NEXTDAY_CENTS=2500